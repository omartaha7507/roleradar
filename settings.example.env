# RoleRadar settings. Copy this file to settings.env and change what you need.
# Lines starting with # are ignored. Restart RoleRadar after a change.

# The local AI model that ranks jobs (any name from "ollama list").
# llama3.1:8b is careful but slow on a laptop CPU (about a minute per job);
# llama3.2 (3B) is about 3x faster but less accurate.
ROLERADAR_OLLAMA_MODEL=llama3.1:8b

# Seconds to wait for the model per job before giving up on that job.
ROLERADAR_OLLAMA_TIMEOUT=300

# The Claude model that writes CVs and cover letters (an alias Claude Code accepts).
ROLERADAR_CLAUDE_MODEL=sonnet

# The port of the dashboard: http://127.0.0.1:8787
ROLERADAR_PORT=8787

# Uncomment if RoleRadar can't find Chrome for making PDFs:
# ROLERADAR_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
